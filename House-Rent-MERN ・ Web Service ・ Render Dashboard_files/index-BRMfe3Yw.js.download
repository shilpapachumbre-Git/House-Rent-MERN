  fragment customDomainFields on CustomDomain {
    id
    name
    verified
    publicSuffix
    redirectForName
    isApex
    server {
      id
      name
      userFacingTypeSlug
      environment {
        id
        name
        project {
          id
          name
        }
      }
    }
  }
`,jQ=new wa(W`
  query customDomains($serverId: String!) {
    customDomains(serverId: $serverId) {
      ...customDomainFields
    }
