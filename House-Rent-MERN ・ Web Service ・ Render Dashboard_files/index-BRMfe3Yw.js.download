  query notificationSettings($entityId: String!) {
    notificationSettings(entityId: $entityId) {
      emailEnabled
      notificationsToSend
      previewNotificationsEnabled
      slackConnected
      overrides {
        serviceId
      }
    }
  }
`),ZI=new Ya(W`
  mutation updateNotificationSettings(
    $entityId: String!
    $patch: NotificationSettingsInput!
  ) {
    updateNotificationSettings(entityID: $entityId, patch: $patch) {
      entityId
      emailEnabled
      notificationsToSend
      previewNotificationsEnabled
      slackConnected
    }
  }
`),QI=new wa(W`
  query notificationOverride($serviceId: String!, $entityId: String!) {
    notificationOverride(serviceId: $serviceId) {
      serviceId
      notificationsToSend
      previewNotificationsEnabled
    }

    notificationSettings(entityId: $entityId) {
      entityId
      notificationsToSend
      previewNotificationsEnabled
    }
  }
`),$I=new Ya(W`
  mutation updateNotificationOverride(
    $patch: NotificationOverrideInput!
    $serviceID: String!
  ) {
    updateNotificationOverride(patch: $patch, serviceID: $serviceID) {
      serviceId
      notificationsToSend
      previewNotificationsEnabled
    }
  }
`),eL=new wa(W`
  query servicesForOwnerOverrides(
    $ownerId: String!
    $includeSharedServices: Boolean
    $emptyEnvironmentOnly: Boolean
  ) {
    servicesForOwner(
      ownerId: $ownerId
      includeSharedServices: $includeSharedServices
      emptyEnvironmentOnly: $emptyEnvironmentOnly
    ) {
      userFacingTypeSlug
      name
      id
