  mutation updateWorkflowRootDir(
    $id: String!
    $input: UpdateWorkflowServiceInput!
  ) {
    updateWorkflowService(workflowServiceId: $id, input: $input) {
      id
      runCommand
      buildConfig {
        rootDir
        buildCommand
        dockerFilePath
        baseDir
      }
